{
	"schemaVersion": 1,
	"id": "z80zhealthbar",
	"version": "${version}",
	"name": "Z80Z Health Bar",
	"description": "Unified mob health display and player HUD replacement mod. Entity health bars, a customisable HUD and layout editor, plus optional AppleSkin, Thirst Was Taken and ParCool integration.",
	"authors": ["Z80Z99"],
	"contact": {
		"homepage": "https://github.com/Z80Z99/z80z-healthbar",
		"sources": "https://github.com/Z80Z99/z80z-healthbar"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.z80z99.z80zhealthbar.fabric.Z80ZHealthBarFabric"
		],
		"client": [
			"com.z80z99.z80zhealthbar.fabric.Z80ZHealthBarFabric"
		],
		"modmenu": [
			"com.z80z99.z80zhealthbar.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"z80zhealthbar.mixins.json"
	],
	"accessWidener": "z80zhealthbar.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
